<mujoco model="dog">
    <compiler angle="degree"/>
    <option timestep="0.001" gravity="0 0 -9.81"/>

    <!-- solref controls how soft/stiff constraints are -->
    <default>
        <equality solref="0.005 1" />
        <geom type="box" size="0.05 0.02 0.02" density="500" rgba="0.2 0.7 0.2 1"/>
        <!-- damping for a joint tells how stiff the joint is, 0.2 is light so its smooth but not too sluggish either -->
        <joint limited="true" range="-300 300"  armature="0.005"/>
        <!-- ctrlrange is the amount of power this joint gets. too high and it could break, too low and maybe it cant stand -->
        <motor ctrllimited="true" ctrlrange="-10 10"/>
    </default>

    <statistic center="1 -0.8 1.1" extent=".3"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="140" elevation="-20"/>
    </visual>

    <asset>
        <texture builtin='checker' height='512' name='plane' rgb1='0.2 0.2 0.2' rgb2='0.3 0.3 0.3' type='2d' width='512'/>
        <texture builtin='gradient' height='128' rgb1='0.4 0.6 0.8' rgb2='0 0 0' type='skybox' width='128'/>
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0" width="300" height="300"/>
        <material name='plane' reflectance='0.000000' texrepeat='1 1' texture='plane' texuniform='true'/>
    </asset>

    <worldbody>

        <geom conaffinity="1" contype="1" condim="3" friction="1 .1 .1" name="floor" pos="0 0 0" size="40 40 0.125" type="plane" material="plane" rgba="0.5 0.5 0.5 1.0"/>


        <body name="torso" pos="0 0 0.3">
            <joint type="free"/>
            <geom name="torso_geom" type="box" size="0.20 0.03 0.03" />

            <!-- front left leg -->
            <body name="fl_leg" pos="0.2 0.05 -0.02">
                <geom name= "fl_hip" type="box" size="0.05 0.02 0.02" pos="0 0 0"/>
                <joint name="fl_hip_x" type="hinge" axis="1 0 0" pos="0 0 0" damping="1" stiffness="7"/>
                
                <body name="fl_thigh" pos="-0.01 0.03 -0.05">
                    <joint name="front_left_hip" type="hinge" axis="0 1 0" pos="0 0 0.04"/>
                    <geom type="box" size="0.01 0.01 0.05" pos="0 0 0"/>

                    <body name="fl_shin" pos="0 -0.02 -0.1">
                        <joint name="front_left_knee" type="hinge" axis="0 1 0" pos="0 0 0.05"/>
                        <geom type="box" size="0.01 0.01 0.05" pos="0 0 0"/>

                        <body name="fl_foot" pos="0 0 -0.05">
                            <geom type="sphere" size="0.015"/>
                        </body>
                    </body>
                </body>
            </body>

            <!-- front right leg -->
            <body name="fr_leg" pos="0.2 -0.05 -0.02">
                <geom name= "fr_hip" type="box" size="0.05 0.02 0.02" pos="0 0 0"/>
                <joint name="fr_hip_x" type="hinge" axis="1 0 0" pos="0 0 0" damping="2" stiffness="7"/>
                
                
                <body name="fr_thigh" pos="-0.01 -0.03 -0.05">
                    <joint name="front_right_hip" type="hinge" axis="0 1 0" pos="0 0 0.04"/>
                    <geom type="box" size="0.01 0.01 0.05" pos="0 0 0"/>

                    <body name="fr_shin" pos="0 0.02 -0.1">
                        <joint name="front_right_knee" type="hinge" axis="0 1 0" pos="0 0 0.05"/>
                        <geom type="box" size="0.01 0.01 0.05" pos="0 0 0"/>

                        <body name="fr_foot" pos="0 0 -0.05">
                            <geom type="sphere" size="0.015"/>
                        </body>
                    </body>
                </body>
            </body>

            <!-- back left leg -->
            <body name="bl_leg" pos="-0.2 0.05 -0.02">
                <geom name= "bl_hip" type="box" size="0.05 0.02 0.02" pos="0 0 0"/>
                <joint name="bl_hip_x" type="hinge" axis="1 0 0" pos="0 0 0" damping="2" stiffness="7"/>
               
                <body name="bl_thigh" pos="0.01 0.03 -0.05">
                    <joint name="back_left_hip" type="hinge" axis="0 1 0" pos="0 0 0.04"/>
                    <geom type="box" size="0.01 0.01 0.05" pos="0 0 0"/>

                    <body name="bl_shin" pos="0 -0.02 -0.1">
                        <joint name="back_left_knee" type="hinge" axis="0 1 0" pos="0 0 0.05"/>
                        <geom type="box" size="0.01 0.01 0.05" pos="0 0 0"/>

                        <body name="bl_foot" pos="0 0 -0.05">
                            <geom type="sphere" size="0.015"/>
                        </body>
                    </body>
                </body>
            </body>

            <!-- back right leg -->
            <body name="br_leg" pos="-0.2 -0.05 -0.02">
                <geom name= "br_hip" type="box" size="0.05 0.02 0.02" pos="0 0 0"/>
                <joint name="br_hip_x" type="hinge" axis="1 0 0" pos="0 0 0" damping="1" stiffness="7"/>
                
                <body name="br_thigh" pos="0.01 -0.03 -0.05">
                    <joint name="back_right_hip" type="hinge" axis="0 1 0" pos="0 0 0.04"/>
                    <geom type="box" size="0.01 0.01 0.05" pos="0 0 0"/>

                    <body name="br_shin" pos="0 0.02 -0.1">
                        <joint name="back_right_knee" type="hinge" axis="0 1 0" pos="0 0 0.05"/>
                        <geom type="box" size="0.01 0.01 0.05" pos="0 0 0"/>

                        <body name="br_foot" pos="0 0 -0.05">
                            <geom type="sphere" size="0.015"/>
                        </body>
                    </body>
                </body>
            </body>
            
        </body>

    </worldbody>

    <actuator>
        <motor joint="fl_hip_x" name="fl_hip_x_motor"/>
        <motor joint="front_left_hip" name="fl_hip_motor"/>
        <motor joint="front_left_knee" name="fl_knee_motor"/>
        <motor joint="fr_hip_x" name="fr_hip_x_motor"/>
        <motor joint="front_right_hip" name="fr_hip_motor"/>
        <motor joint="front_right_knee" name="fr_knee_motor"/>
        <motor joint="bl_hip_x" name="bl_hip_x_motor"/>
        <motor joint="back_left_hip" name="bl_hip_motor"/>
        <motor joint="back_left_knee" name="bl_knee_motor"/>
        <motor joint="br_hip_x" name="br_hip_x_motor"/>
        <motor joint="back_right_hip" name="br_hip_motor"/>
        <motor joint="back_right_knee" name="br_knee_motor"/>
    </actuator>

    <sensor>
        <jointpos joint="fl_hip_x" name="fl_hip_x_sensor"/>
        <jointpos joint="front_left_hip" name="fl_hip_sensor"/>
        <jointpos joint="front_left_knee" name="fl_knee_sensor"/>
        <jointpos joint="fr_hip_x" name="fr_hip_x_sensor"/>        
        <jointpos joint="front_right_hip" name="fr_hip_sensor"/>
        <jointpos joint="front_right_knee" name="fr_knee_sensor"/>
        <jointpos joint="bl_hip_x" name="bl_hip_x_sensor"/>
        <jointpos joint="back_left_hip" name="bl_hip_sensor"/>
        <jointpos joint="back_left_knee" name="bl_knee_sensor"/>
        <jointpos joint="br_hip_x" name="br_hip_x_sensor"/>
        <jointpos joint="back_right_hip" name="br_hip_sensor"/>
        <jointpos joint="back_right_knee" name="br_knee_sensor"/>
    </sensor>


</mujoco>